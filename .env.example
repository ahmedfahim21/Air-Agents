# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Deployed functions get these from Supabase secrets, not from this file:
#   npx supabase secrets set --env-file .env

# --- Model: Claude on Amazon Bedrock (needed now) ---
# Bedrock console → API keys. A short-term key is fine for local runs.
AWS_BEARER_TOKEN_BEDROCK=
# Bedrock console → Inference profiles. The fast model for spoken turns.
BEDROCK_MODEL_ID=
# The larger model for background runs. Leave empty until background runs exist.
BEDROCK_BACKGROUND_MODEL_ID=
BEDROCK_REGION=us-east-1

# --- Supabase (needed once the project exists) ---
# Project Settings → API. Supabase injects these into deployed functions itself;
# they are here for local runs and tests against the real project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security. Never ship it in the app.
SUPABASE_SECRET_KEY=

# --- Speech: Sarvam (needed for the speech bake-off) ---
SARVAM_API_KEY=

# --- Integrations: Composio (needed for connections) ---
COMPOSIO_API_KEY=

# --- Push: Apple Push Notification service (needed for Lock Screen requests) ---
# developer.apple.com → Keys. APNS_PRIVATE_KEY is the .p8 file's contents on one line,
# with \n where the line breaks were.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.airagents.ios
APNS_PRIVATE_KEY=

# --- Errors: Sentry (optional until testers exist) ---
SENTRY_DSN=
